PORT=3001

# 设为非空则启用 API Key 鉴权（所有 /api/* 需 Bearer Token）
OFFERPILOT_API_KEY=

# 默认模型（不设则自动选择第一个可用的 Provider）
DEFAULT_MODEL=

# ---- Anthropic Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# ---- DeepSeek (OpenAI 兼容) ----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=

# ---- 知识库 SQLite 路径 ----
KNOWLEDGE_DB_PATH=./data/knowledge.db

# ---- MySQL 连接 ----
MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/offerpilot?parseTime=true&charset=utf8mb4

# ---- CORS 允许的域名（逗号分隔） ----
ALLOWED_ORIGIN=http://localhost:3001

# 仅在服务直接位于可信反向代理后时启用
TRUST_PROXY_HEADERS=false

# HTTPS 部署时设为 true，确保登录 Cookie 只通过 TLS 发送
COOKIE_SECURE=false
